# ===============================================
# ParkU Backend Environment Variables
# ===============================================

# Database Connection URL:
# 1. For PostgreSQL (e.g. Render, Supabase, Neon, or Local Postgres):
#    DATABASE_URL=postgresql://user:password@localhost:5432/parku_db
# 2. For SQLite (default if left blank):
#    DATABASE_URL=sqlite:///./parku.db
DATABASE_URL=sqlite:///./parku.db

# Google Gemini API Key (Get free key from https://aistudio.google.com/):
GEMINI_API_KEY=

# JWT Authentication Secret Key (Generate a random 64-char string for production):
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION_DAYS=30

# Server Configuration:
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

